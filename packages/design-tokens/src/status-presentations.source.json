  "forcedColors": [
    {
      "id": "forced.action",
      "roles": ["action.surface", "action.text"],
      "systemColors": ["ButtonFace", "ButtonText"],
      "presentation": "button-semantics"
    },
    {
      "id": "forced.base-surface",
      "roles": ["background.base", "background.surface"],
      "systemColors": ["Canvas"],
      "presentation": "opaque-canvas"
    },
    {
      "id": "forced.disabled",
      "roles": ["status.disabled"],
      "systemColors": ["GrayText"],
      "presentation": "label-and-disabled-state"
    },
    {
      "id": "forced.essential-boundary",
      "roles": ["border.emphasis"],
      "systemColors": ["ButtonText"],
      "presentation": "2px-boundary"
    },
    {
      "id": "forced.focus",
      "roles": ["focus.ring"],
      "systemColors": ["Highlight", "Canvas"],
      "presentation": "2px-ring-plus-2px-offset"
    },
    {
      "id": "forced.link",
      "roles": ["text.link"],
      "systemColors": ["LinkText"],
      "presentation": "underline"
    },
    {
      "id": "forced.quality-capability",
      "roles": ["quality.*", "capability.*"],
      "systemColors": ["CanvasText"],
      "presentation": "distinct-label-icon-shape"
    },
    {
      "id": "forced.selected",
      "roles": ["surface.selected", "text.inverse"],
      "systemColors": ["Highlight", "HighlightText"],
      "presentation": "selected-pair"
    },
    {
      "id": "forced.text",
      "roles": ["text.primary", "text.secondary"],
      "systemColors": ["CanvasText"],
      "presentation": "ordinary-text"
    },
    {
      "id": "forced.warning-critical",
      "roles": ["status.warning", "status.critical"],
      "systemColors": ["Mark", "MarkText"],
      "presentation": "required-icon-and-label"
    }
  ],
  "systemColorAllowlist": [
    "ButtonFace",
    "ButtonText",
    "Canvas",
    "CanvasText",
    "GrayText",
    "Highlight",
    "HighlightText",
    "LinkText",
    "Mark",
    "MarkText"
  ]
