  "emphasis": [
    {
      "id": "chart.emphasis.highlight",
      "opacity": "1",
      "strokeWidth": 2,
      "marker": "endpoint"
    },
    {
      "id": "chart.emphasis.muted",
      "opacity": "0.35",
      "strokeWidth": 1,
      "marker": "preserve-series-marker"
    },
    {
      "id": "chart.emphasis.selected",
      "opacity": "1",
      "strokeWidth": 3,
      "marker": "preserve-series-marker-or-halo"
    }
  ]
