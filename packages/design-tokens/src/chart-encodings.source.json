    "dark": ["#102A4C", "#164678", "#1D63A8", "#3384FF", "#B5D8FF"],
    "constraints": ["AREA_FILL_ONLY", "REQUIRES_LEGEND"]
  },
  "diverging": {
    "id": "chart.scale.diverging",
